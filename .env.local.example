# VibeStudio environment variables.
# Copy this file to .env.local and fill in what you actually want to use.
# All values are optional — the studio works without them, just with reduced features.

# ---------- AI ----------
# Anthropic API key. If unset, the studio falls back to deterministic templates
# instead of live Claude calls. Get one at https://console.anthropic.com.
ANTHROPIC_API_KEY=

# Model to use. Defaults to claude-sonnet-4-6 if unset.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------- Auto-posting + analytics via Buffer ----------
# Buffer is the simplest cross-platform scheduler. Create an app token at
# https://buffer.com/developers/apps. It can post to LinkedIn, Facebook, Instagram,
# Threads, and more from a single token.
BUFFER_ACCESS_TOKEN=

# JSON map of platform -> Buffer profile ID. The map shape is required so each
# per-platform variant lands on the matching profile (not fanned out to all).
# Build it with:
#   curl -H "Authorization: Bearer $BUFFER_ACCESS_TOKEN" https://api.bufferapp.com/1/profiles.json | jq '[.[] | { (.service): .id }] | add'
BUFFER_PROFILES_JSON=

# (Legacy: BUFFER_PROFILE_IDS comma-separated — rejected with 501 by /api/publish/buffer.)

# ---------- Auto-posting via webhook ----------
# Generic outbound webhook (Make.com, n8n, Zapier, custom). The studio POSTs the
# scheduled piece as JSON; your scenario handles the actual platform call.
PUBLISH_WEBHOOK_URL=

# Optional shared secret. The legacy publisher sends it as an authenticated header
# so your webhook can verify the request.
PUBLISH_WEBHOOK_SECRET=

# ---------- Data layer ----------
# Override the parent-folder path if you move studio/ out of the project.
# Defaults to ../ relative to studio/.
ARUTLEE_PROJECT_ROOT=
