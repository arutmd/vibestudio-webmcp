{
  "name": "vibestudio-webmcp",
  "version": "0.1.0",
  "private": true,
  "description": "VibeStudio — AI-native creator workspace for human-agent collaboration.",
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev -p 4321",
    "dev:demo": "VIBESTUDIO_DEMO_MODE=1 NEXT_DIST_DIR=.next-demo next dev -p 4323",
    "dev:4322": "NEXT_DIST_DIR=.next-dev next dev -p 4322",
    "dev:4322:clean": "rm -rf .next-dev && NEXT_DIST_DIR=.next-dev next dev -p 4322",
    "assistant:daemon": "tsx scripts/assistant-daemon.ts",
    "build": "next build",
    "start": "next start -p ${PORT:-4321}",
    "test": "node scripts/run-local-tests.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@phosphor-icons/react": "^2.1.10",
    "next": "^16.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3"
  }
}
